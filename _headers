# Security headers for Cloudflare Pages.
# connect-src allows the API origin (set CORS_ALLOWED_ORIGINS on the backend to
# match https://app.<domain>). 'self' covers Pages-served assets.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.selfhosts.net https://api.selfhosts.net; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-ancestors 'none'
